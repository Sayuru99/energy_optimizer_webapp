        </p>
      </div>

      <div class="flex items-center justify-center gap-3 pt-2">
        <button type="button" onclick="document.getElementById('deleteConfirmModal').classList.add('hidden')" class="px-4 py-2 border border-slate-300 text-slate-700 hover:bg-slate-50 text-xs font-semibold rounded-lg transition-colors">
          No, Keep Machine
        </button>
        <button type="button" onclick="document.getElementById('deleteConfirmModal').classList.add('hidden'); alert('Machine successfully removed.');" class="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold rounded-lg shadow-sm transition-all">
          Yes, Delete Machine
        </button>
      </div>
    </div>
  </div>

  <!-- INTERACTIVE LOGIC SCRIPTS -->
  <script>
    function calculateEnergy() {
      const qty = parseFloat(document.getElementById('mQty').value) || 0;
      const power = parseFloat(document.getElementById('mPower').value) || 0;
      const hours = parseFloat(document.getElementById('mHours').value) || 0;

      const totalPower = (qty * power).toFixed(1);
      const dailyEnergy = (qty * power * hours).toFixed(1);

      document.getElementById('calcTotalPower').innerText = totalPower + " kW";
      document.getElementById('calcDailyEnergy').innerText = dailyEnergy + " kWh";
    }

    function checkWindowValidity() {
      const start = document.getElementById('mStartTime').value;
      const end = document.getElementById('mEndTime').value;
      const requiredHours = parseFloat(document.getElementById('mHours').value) || 0;

      if (!start || !end) return;

      const [startH, startM] = start.split(':').map(Number);
      const [endH, endM] = end.split(':').map(Number);

      const startTotal = startH + startM / 60;
      const endTotal = endH + endM / 60;
      const duration = endTotal - startTotal;

      const badge = document.getElementById('windowDurationBadge');
      const alertBox = document.getElementById('windowErrorAlert');

      if (duration <= 0) {
        badge.innerText = 'Invalid Time Window';
        badge.className = 'text-[11px] font-mono font-semibold px-2 py-0.5 bg-rose-100 text-rose-800 rounded';
        alertBox.classList.remove('hidden');
        alertBox.querySelector('span').innerText = 'Earliest start time must be before latest end time.';
      } else {
        badge.innerText = 'Window: ' + duration.toFixed(1) + ' Hours';
        badge.className = 'text-[11px] font-mono font-semibold px-2 py-0.5 bg-emerald-100 text-emerald-800 rounded';

        if (requiredHours > duration) {
          alertBox.classList.remove('hidden');
          alertBox.querySelector('span').innerText = 'Required runtime cannot fit within the selected operating window.';
        } else {
          alertBox.classList.add('hidden');
        }
      }
    }

    function saveNewMachine() {
      const alertBox = document.getElementById('windowErrorAlert');
      if (!alertBox.classList.contains('hidden')) {
        alert('Please fix the validation error: ' + alertBox.querySelector('span').innerText);
        return;
      }
      document.getElementById('addMachineModal').classList.add('hidden');
      alert('Machine information successfully saved and added to optimization registry.');
    }
  </script>
</body>
</html>
